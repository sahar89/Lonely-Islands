  "sentences": [
    { "book": "242",   "para": 98,   "theme": "migration",  "start": "The first time I see my papa laugh", "end": "in this kawntree." },
    { "book": "242",   "para": 75,   "theme": "migration",  "start": "My grandmother always spoke", "end": "as if they were deaf." },
    { "book": "242",   "para": 10,   "theme": "friendship", "start": "Although Jim Burden and I both live", "end": "I do not see much of him there." },
    { "book": "242",   "para": 792,  "theme": "separation", "start": "She was so quietly conventionalized", "end": "without seeing her." },
    { "book": "242",   "para": 119,  "theme": "connection", "start": "When it began to chirp faintly", "end": "a beautiful sound." },
    { "book": "24",    "para": 323,  "theme": "separation", "start": "I've been away engraving", "end": "made your own." },
    { "book": "24",    "para": 556,  "theme": "friendship", "start": "But I have needed you", "end": "a great many years." },
    { "book": "24",    "para": 691,  "theme": "connection", "start": "There was another period of silence", "end": "happiest half-hours." },
    { "book": "24",    "para": 139,  "theme": "migration",  "start": "So many people are trying to leave the country", "end": "make them low-spirited." },
    { "book": "24",    "para": 365,  "theme": "friendship", "start": "But Marie is really a companion", "end": "quite frankly." },
    { "book": "2814",  "para": 176,  "theme": "belonging",  "start": "Down far in the avenue", "end": "She knew the air." },
    { "book": "4517",  "para": 609,  "theme": "separation", "start": "They stood looking at each other", "end": "the other's image." },
    { "book": "4517",  "para": 361,  "theme": "connection" },
    { "book": "4517",  "para": 737,  "theme": "belonging",  "start": "I don't believe but what", "end": "over twenty years." },
    { "book": "4517",  "para": 673,  "theme": "separation" },
    { "book": "1429",  "para": 274,  "theme": "belonging",  "start": "And somewhere, far away", "end": "lighting a lamp." },
    { "book": "1429",  "para": 892,  "theme": "separation", "start": "She was like a woman who is saying", "end": "before the train starts." },
    { "book": "1429",  "para": 952,  "theme": "separation", "start": "I'm always waiting", "end": "in all kinds of places..." },
    { "book": "13415", "para": 656,  "theme": "friendship", "start": "To have you near me", "end": "when I go back home." },
    { "book": "13415", "para": 443,  "theme": "belonging",  "start": "I thought we should talk", "end": "till morning." },
    { "book": "5670",  "para": 246,  "theme": "connection", "start": "A deep breath is taken", "end": "evaporate unused." },
    { "book": "5670",  "para": 1176, "theme": "separation", "start": "Shading her eyes with her hand", "end": "looking out to sea." },
    { "book": "5670",  "para": 282,  "theme": "connection" },
    { "book": "35698", "para": 270,  "theme": "friendship", "start": "I wrote to Hunt yesterday", "end": "what I said in it." },
    { "book": "35698", "para": 507,  "theme": "friendship", "start": "I will call on you at 4", "end": "the Land of Harpsicols." },
    { "book": "35698", "para": 839,  "theme": "migration",  "start": "My brother George has ever been", "end": "for his happiness." },
    { "book": "35698", "para": 839,  "theme": "separation", "start": "As I walk along the Mountains here", "end": "my return to town." },
    { "book": "35698", "para": 762,  "theme": "connection", "start": "I endeavoured to drink in the Prospect", "end": "I cannot recollect it" },
    { "book": "105",   "para": 354,  "theme": "connection", "start": "Her spirits wanted the solitude", "end": "numbers could give." },
    { "book": "105",   "para": 936,  "theme": "belonging",  "start": "She was earnestly begged", "end": "as silent as she chose." },
    { "book": "105",   "para": 653,  "theme": "friendship", "start": "None, I thank you", "end": "our road lies together." },
    { "book": "44",    "para": 1178, "theme": "migration",  "start": "We immigrants never speak", "end": "any language well." },
    { "book": "44",    "para": 667,  "theme": "friendship", "start": "I feel just as much at home with you", "end": "as ever, now." },
    { "book": "44",    "para": 499,  "theme": "belonging",  "start": "Somehow I can think better", "end": "in a little room." },
    { "book": "44",    "para": 893,  "theme": "friendship", "start": "Even a short talk with Thomas", "end": "always stimulated him." },
    { "book": "205",   "para": 29,   "theme": "belonging",  "start": "At present I am a sojourner", "end": "civilized life again." },
    { "book": "1142",  "para": 69,   "theme": "separation" },
    { "book": "1260",  "para": 460,  "theme": "connection" },
    { "book": "6524",  "para": 16,   "theme": "connection", "start": "Once we dreamt", "end": "dear to each other." },
    { "book": "6524",  "para": 293,  "theme": "migration",  "start": "I came to your shore", "end": "as a friend, my earth." },
    { "book": "6524",  "para": 92,   "theme": "friendship", "start": "Your voice, my friend", "end": "these listening pines." },
    { "book": "6522",  "para": 41,   "theme": "belonging",  "start": "Alas, I cannot stay in the house", "end": "along the road." },
    { "book": "17340", "para": 307,  "theme": "connection", "start": "Es de día, cuando estamos juntos", "end": "cuando nos separamos." },
    { "book": "2000",  "para": 2212, "theme": "friendship", "start": "juntos salimos", "end": "por los dos" },
    { "book": "2000",  "para": 2648, "theme": "friendship", "start": "Mas si es verdad lo que comúnmente se dice", "end": "suele servir de alivio en ellos" },
    { "book": "2407",  "para": 63,   "theme": "belonging", "start": "Ich bin allein und freue mich", "end": "wie die meine." },
    { "book": "2407",  "para": 72,   "theme": "connection", "start": "Ich weiß nicht, was ich Anzügliches", "end": "miteinander geht." },
    { "book": "2407",  "para": 102,  "theme": "friendship", "start": "Da bin ich wieder, Wilhelm", "end": "dir schreiben." },
    { "book": "2407",  "para": 142,  "theme": "friendship", "start": "du vermagst nichts auf deine Freunde", "end": "mit ihnen genießest." },
    { "book": "2407",  "para": 217,  "theme": "friendship", "start": "So kommen sie meinen Wünschen zuvor", "end": "des Gebers erniedrigt." },
    { "book": "2407",  "para": 164,  "theme": "connection", "start": "Ich schickte meinen Diener hinaus", "end": "nahe gekommen wäre." },
    { "book": "55236", "para": 143,  "theme": "belonging", "start": "Sempre caro mi fu", "end": "il guardo esclude.", "verse": true },
    { "book": "55236", "para": 143,  "theme": "connection", "start": "Così tra questa", "end": "in questo mare.", "verse": true },
    { "book": "55236", "para": 146,  "theme": "connection", "start": "Dolce e chiara", "end": "ogni montagna.", "verse": true }
  ],
